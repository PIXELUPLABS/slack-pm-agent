{
  "name": "pixelup-slack-pm-agent",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "auth:clickup": "node scripts/authorize-mcp.js clickup",
    "auth:fireflies": "node scripts/authorize-mcp.js fireflies",
    "sync:channels": "node scripts/sync-channel-ids.js",
    "check": "npx tsc --checkJs --noEmit --skipLibCheck --esModuleInterop --target esnext --module nodenext --moduleResolution nodenext app.js",
    "start": "node app.js",
    "lint": "npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.206",
    "@anthropic-ai/sdk": "^0.93.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/bolt": "^4.7.3",
    "dotenv": "~17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@slack/cli-hooks": "^1.3.3",
    "typescript": "^6.0.3"
  }
}
